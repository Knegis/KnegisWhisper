{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".test-build",
    "noEmit": false,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.test.ts"],
  "exclude": ["node_modules", ".test-build"]
}
