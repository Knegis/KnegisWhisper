# Rust
/target
**/target/
*.pdb

# Node
node_modules/
dist/
dist-ssr/
/apps/desktop/.test-build/
/apps/desktop/.notice-build/
*.local

# Tauri
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target/

# Downloaded sidecars and models — never committed, always fetched with a pinned
# version and a verified digest. See docs/ARCHITECTURE.md.
/sidecars/**/bin/
/sidecars/**/*.exe
/sidecars/**/*.dll
/sidecars/**/*.dylib
/sidecars/**/*.so
/sidecars/**/*.gguf
/sidecars/**/*.bin
/sidecars/**/*.onnx

# Secrets — the app stores credentials in the OS credential store, never in a
# file. Anything matching these is a mistake, not a config.
.env
.env.*
!.env.example
*.pem
*.key
secure-keys/

# Local scratch notes. The engineering log itself is committed at
# docs/ENGINEERING_LOG.md — findings that were invisible by inspection are worth
# nothing if the only copy is on one machine. What stays ignored is in-the-moment
# scribbling that has not earned a place there yet.
*.local.md

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Python release tooling
__pycache__/

# Local implementation validation artifacts
/.validation/
